# Required for organizer access. Replace this with a private passcode and
# keep the real value in an untracked local .env or the host's secret settings.
ADMIN_PASSCODE="REPLACE_WITH_A_PRIVATE_PASSCODE"

# Optional absolute path for local JSON state. Netlify production uses PostgreSQL.
DB_FILE=""

# Production PostgreSQL connection string for Netlify Functions and the one-time
# `npm run migrate:state` import. Keep the real value private.
DATABASE_URL=""

# Exact browser origins allowed by the production API, comma-separated.
# For the single-site Netlify deployment use its canonical https://...netlify.app
# origin. Do not include a path or trailing slash.
FRONTEND_ORIGINS=""

# Optional absolute API origin. Leave blank when frontend and function share
# the Netlify site so that requests remain same-origin.
VITE_API_BASE_URL=""

# Set the port assigned by the Node.js host; defaults to 3000 locally.
PORT="3000"
